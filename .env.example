# Copy to .env and fill in. `npm run setup:env` generates one with random secrets.
# .env is git-ignored. Nothing here is ever sent to the browser
# (no variable uses the NEXT_PUBLIC_ prefix, on purpose).

# Used by scripts/db.sh to initialise Postgres
POSTGRES_PASSWORD=change-me

# App database (port 5433 on loopback, see scripts/db.sh)
DATABASE_URL=postgres://academy:change-me@127.0.0.1:5433/academy
TEST_DATABASE_URL=postgres://academy:change-me@127.0.0.1:5433/academy_test

# Floci endpoint. Must be a loopback http URL; the app refuses anything else.
FLOCI_ENDPOINT=http://localhost:4566
FLOCI_REGION=us-east-1

# Session lifetime in days
SESSION_TTL_DAYS=14
